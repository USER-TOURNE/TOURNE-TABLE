 inline float DbFromPower(double p) { return (float)(10.0 * log10(p > 1e-30 ? p : 1e-30)); }
 
+// The same figure without a libm call, for the per-band loop (one per band per
+// analysis, up to 2048 of them per frame). The power is split into 2^e * m with
+// m in [sqrt(1/2), sqrt(2)), and ln m = 2 atanh(s), s = (m - 1) / (m + 1),
+// |s| <= 0.1716, is summed to s^9: the first term left out is under 3e-9, so
+// the error is set by the float conversion of p, about 3e-7 dB. test_dsp
+// checks it against log10 over 1e-30 .. 1e12.
+inline float FastDbFromPower(double p) {
+    float x = (float)(p > 1e-30 ? p : 1e-30);
+    uint32_t bits;
+    memcpy(&bits, &x, 4);
+    int e = (int)((bits >> 23) & 0xFF) - 127;
+    bits = (bits & 0x007FFFFFu) | 0x3F800000u;  // mantissa as a float in [1, 2)
+    float m;
+    memcpy(&m, &bits, 4);
+    if (m > 1.41421356f) {
+        m *= 0.5f;
+        e++;
+    }
+    double s = (double)(m - 1.f) / (double)(m + 1.f);
+    double s2 = s * s;
+    double ln = 2.0 * s * (1.0 + s2 * (1.0 / 3 + s2 * (1.0 / 5 + s2 * (1.0 / 7 + s2 * (1.0 / 9)))));
+    // 10 log10(2^e m) = 10 / ln 10 * (e ln 2 + ln m)
+    return (float)(4.3429448190325182 * (e * 0.69314718055994531 + ln));
+}
