+// BallisticsStep with its coefficients worked out once per frame instead of
+// once per band: dt, the preset and the range are the same for every band, so
+// this does two exp() per frame where the per-band form did one per band.
+// Same expressions in the same precision, so the output is bit-identical
+// (test_dsp checks it).
+struct BallisticsCoef {
+    double att = 0.0, rel = 0.0;  // 1 - exp(-dt / tau)
+    float fall = 0.f;             // linear release, in display units per step
+    bool linear = false;
+};
+inline BallisticsCoef BallisticsCoefs(double dt, const Ballistics& b, float rangeDb) {
+    BallisticsCoef c;
+    c.att = 1.0 - exp(-dt * 1000.0 / std::max(0.1, b.attackMs));
+    c.linear = b.release == ReleaseKind::Linear;
+    if (c.linear) c.fall = (float)(b.releaseDbPerSec * dt / std::max(1.f, rangeDb));
+    else c.rel = 1.0 - exp(-dt * 1000.0 / std::max(0.1, b.releaseMs));
+    return c;
+}
+inline float BallisticsApply(float y, float x, const BallisticsCoef& c) {
+    if (x > y) return (float)(y + (x - y) * c.att);
+    if (c.linear) return std::max(x, y - c.fall);
+    return (float)(y + (x - y) * c.rel);
+}
