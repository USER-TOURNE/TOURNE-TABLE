+    std::thread ev1([&] { while (!stop) { M.sessions[0].FirePlayback(); M.sessions[1].FireTimeline(); } });
+    std::thread ev2([&] { while (!stop) { M.sessions[1].FirePlayback(); M.sessions[0].FireTimeline(); } });
