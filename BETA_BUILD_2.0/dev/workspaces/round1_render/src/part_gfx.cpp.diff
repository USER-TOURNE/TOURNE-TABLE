+// ---- Text surface attachment -------------------------------------------------------
+// With nothing on the text surface (no Now Playing, readout or progress bar
+// showing) its content is taken off the text visual, so DWM doesn't blend a
+// transparent layer the size of the whole widget every time the bars present.
+// It goes back before anything is shown on it again: by RenderVisualizerD3D
+// after drawing text, and by every way into the Direct2D path (ReleaseSurface
+// runs on every Direct2D frame, and RenderVisualizerD3D reattaches before it
+// falls back), because that path draws the whole scene on g_swapChain.
+bool TextIsDetached() { return g.textDetachedOn && g.textDetachedOn == g_compositionVisual.Get(); }
+
+void TextDetach() {
+    if (TextIsDetached() || !g_compositionVisual || !g_compositionDevice) return;
+    if (FAILED(g_compositionVisual->SetContent(nullptr))) return;
+    g_compositionDevice->Commit();
+    g.textDetachedOn = g_compositionVisual.Get();
+}
+
+void TextAttach() {
+    if (!g.textDetachedOn) return;
+    // A visual rebuilt since was created with its content already set.
+    if (TextIsDetached() && g_swapChain && g_compositionDevice) {
+        g_compositionVisual->SetContent(g_swapChain.Get());
+        g_compositionDevice->Commit();
+    }
+    g.textDetachedOn = nullptr;
+    g.textForce = true;
+}
